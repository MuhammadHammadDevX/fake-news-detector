# ====================================================================
# Factify AI - Environment Configuration Template
# Duplicate this file as 'backend/.env' and fill in your real credentials
# ====================================================================

# AI & Multimodal Analysis APIs
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_google_gemini_api_key_here

# Live News Intelligence API
GNEWS_API_KEY=your_gnews_api_key_here

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Administrator Credentials (Used by backend/setup_admin.py)
ADMIN_EMAIL=admin@factify.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# MongoDB Connection String (Defaults to localhost if omitted)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=factify_db
