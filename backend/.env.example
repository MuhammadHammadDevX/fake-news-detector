# ====================================================================
# Factify AI - Environment Configuration Example
# Copy this file to .env and replace the placeholders with your actual keys
# ====================================================================

# AI Services
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_google_gemini_api_key_here

# News Data API
GNEWS_API_KEY=your_gnews_api_key_here

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Default Admin Credentials (Used by setup_admin.py)
ADMIN_EMAIL=admin@factify.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Database Configuration (Optional, defaults to local MongoDB)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=factify_db
